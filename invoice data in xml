    let xml = '';

    for (let i = 0; i < count; i++) {

        const rawTaxRate1 = Number(getSublistVal(inv, sublistId, 'taxrate1', i)) || 0;
        const rawTaxRate2 = Number(getSublistVal(inv, sublistId, 'taxrate2', i)) || 0;

        const gstRate = getGstRateFromTaxDetails(inv, i + 1);

        const itemId = safe(getSublistVal(inv, sublistId, 'item', i));
        const itemName = safe(getSublistText(inv, sublistId, 'item', i));
        const itemType = safe(getSublistVal(inv, sublistId, 'itemtype', i));
        const description = safe(getSublistVal(inv, sublistId, 'description', i));
        const quantity = safe(getSublistVal(inv, sublistId, 'quantity', i));

        // ✅ UQC VALUE
        const custrecord_uqc_code = safe(
            getSublistText(inv, sublistId, 'custcol_in_uqc', i)
        );

        const rate = safe(getSublistVal(inv, sublistId, 'rate', i));
        const amount = safe(getSublistVal(inv, sublistId, 'amount', i));
        const grossAmount = safe(getSublistVal(inv, sublistId, 'grossamt', i));
        const taxCodeId = safe(getSublistVal(inv, sublistId, 'taxcode', i));
        const taxtype = getTaxTypeFromTaxDetails(inv, i + 1);

        const taxRate1 = rawTaxRate1;
        const taxRate2 = rawTaxRate2;

        const tax1Amt = safe(getSublistVal(inv, sublistId, 'tax1amt', i));
        const taxAmount = safe(getSublistVal(inv, sublistId, 'taxamount', i));
        const location = safe(getSublistText(inv, sublistId, 'location', i));
        const className = safe(getSublistText(inv, sublistId, 'class', i));

        const hsnSac = getItemHsn(itemId, itemType);

        xml +=
            '<line>' +
                tag('lineNumber', i + 1) +
                tag('itemId', itemId) +
                tag('itemName', itemName) +
                tag('itemType', itemType) +
                tag('description', description) +
                tag('quantity', quantity) +
                tag('units', custrecord_uqc_code) +   // ✅ CHANGED HERE
                tag('rate', rate) +
                tag('amount', amount) +
                tag('grossAmount', grossAmount) +
                tag('taxCodeId', taxCodeId) +
                tag('taxtype', taxtype) +
                tag('taxRate1', taxRate1) +
                tag('taxRate2', taxRate2) +
                tag('tax1Amt', tax1Amt) +
                tag('taxAmount', taxAmount) +
                tag('hsnSac', hsnSac) +
                tag('location', location) +
                tag('className', className) +
                tag('gstRate', gstRate) +
            '</line>';
    }

    return xml;
}
    function getItemHsn(itemId, itemType) {
        try {
            if (!itemId) return '';
            if (hsnCache[itemId]) return hsnCache[itemId];

            const recordType = resolveItemRecordType(itemType);
            if (!recordType) return '';

            const itemRec = record.load({
                type: recordType,
                id: itemId,
                isDynamic: false
            });

            let hsnCode = safe(itemRec.getText({ fieldId: 'custitem_in_hsn_code' }));

            if (!hsnCode) {
                hsnCode = safe(itemRec.getValue({ fieldId: 'custitem_in_hsn_code' }));
            }

            hsnCache[itemId] = hsnCode;
            return hsnCode;

        } catch (e) {
            return '';
        }
    }

    function resolveItemRecordType(itemType) {
        switch (itemType) {
            case 'InvtPart': return record.Type.INVENTORY_ITEM;
            case 'Service': return record.Type.SERVICE_ITEM;
            case 'NonInvtPart': return record.Type.NON_INVENTORY_ITEM;
            case 'Assembly': return record.Type.ASSEMBLY_ITEM;
            case 'OthCharge': return record.Type.OTHER_CHARGE_ITEM;
            case 'Kit': return record.Type.KIT_ITEM;
            case 'Group': return record.Type.ITEM_GROUP;
            default: return record.Type.NON_INVENTORY_ITEM;
        }
    }

    function buildTaxDetailsXml(inv) {
        const sublistId = 'taxdetails';
        let count = 0;

        try {
            count = safeNumber(inv.getLineCount({ sublistId }));
        } catch (e) {
            return '';
        }

        let xml = '';

        for (let i = 0; i < count; i++) {
            const taxBasis = safe(getSublistVal(inv, sublistId, 'taxbasis', i));
            const taxRate = firstNonBlank(
                safe(getSublistVal(inv, sublistId, 'taxrate', i)),
                safe(getSublistVal(inv, sublistId, 'taxrate1', i))
            );
            const taxAmount = firstNonBlank(
                safe(getSublistVal(inv, sublistId, 'taxamount', i)),
                safe(getSublistVal(inv, sublistId, 'tax1amt', i))
            );
            const taxCode = safe(getSublistText(inv, sublistId, 'taxcode', i));
            const taxType = firstNonBlank(
                safe(getSublistText(inv, sublistId, 'taxtype', i)),
                safe(getSublistVal(inv, sublistId, 'taxtype', i))
            );
            const lineRef = firstNonBlank(
                safe(getSublistVal(inv, sublistId, 'taxdetailsreference', i)),
                safe(getSublistVal(inv, sublistId, 'linesequencenumber', i))
            );
            const netAmount = safe(getSublistVal(inv, sublistId, 'netamount', i));
            const grossAmount = safe(getSublistVal(inv, sublistId, 'grossamount', i));

            xml +=
                '<taxLine>' +
                    tag('lineNumber', i + 1) +
                    tag('lineReference', lineRef) +
                    tag('taxType', taxType) +
                    tag('taxCode', taxCode) +
                    tag('taxBasis', taxBasis) +
                    tag('taxRate', taxRate) +
                    tag('taxAmount', taxAmount) +
                    tag('netAmount', netAmount) +
                    tag('grossAmount', grossAmount) +
                '</taxLine>';
        }

        return xml;
    }

    function loadRecordSafe(type, id) {
        try {
            if (!id) return null;
            return record.load({
                type: type,
                id: id,
                isDynamic: false
            });
        } catch (e) {
