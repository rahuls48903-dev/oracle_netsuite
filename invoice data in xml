            if (!subrec) return {};

            return {
                country: safe(getSubVal(subrec, 'country')),
                addressee: safe(getSubVal(subrec, 'addressee')),
                attention: safe(getSubVal(subrec, 'attention')),
                addrPhone: safe(getSubVal(subrec, 'addrphone')),
                addr1: safe(getSubVal(subrec, 'addr1')),
                addr2: safe(getSubVal(subrec, 'addr2')),
                addr3: safe(getSubVal(subrec, 'addr3')),
                city: safe(getSubVal(subrec, 'city')),
                state: safe(getSubVal(subrec, 'state')),
                zip: safe(getSubVal(subrec, 'zip'))
            };
        } catch (e) {
            return {};
        }
    }

    function addressXml(addr) {
        return '' +
            tag('country', addr.country) +
            tag('addressee', addr.addressee) +
            tag('attention', addr.attention) +
            tag('phone', addr.addrPhone) +
            tag('line1', addr.addr1) +
            tag('line2', addr.addr2) +
            tag('line3', addr.addr3) +
            tag('city', addr.city) +
            tag('state', addr.state) +
            tag('zip', addr.zip);
    }

    function xmlResponse(body) {
        return restlet.createResponse({
            content: body,
            contentType: 'application/xml'
        });
    }

    function errorXml(code, message) {
        return '<?xml version="1.0" encoding="UTF-8"?>' +
            '<response>' +
                tag('status', 'error') +
                tag('code', code) +
                tag('message', message) +
            '</response>';
    }

    function tag(name, value) {
        return '<' + name + '>' + esc(safe(value)) + '</' + name + '>';
    }

    function safe(v) {
        return v == null ? '' : String(v);
    }

    function safeNumber(v) {
        return v == null || v === '' ? 0 : Number(v);
    }

    function firstNonBlank() {
        for (let i = 0; i < arguments.length; i++) {
            if (arguments[i] !== null && arguments[i] !== undefined && String(arguments[i]) !== '') {
                return String(arguments[i]);
            }
        }
        return '';
    }

    function esc(v) {
        return String(v)
            .replace(/&/g, '&amp;')
            .replace(/</g, '&lt;')
            .replace(/>/g, '&gt;')
            .replace(/"/g, '&quot;')
            .replace(/'/g, '&apos;');
    }

    function getVal(rec, fieldId) {
        try { return rec.getValue({ fieldId: fieldId }); } catch (e) { return ''; }
    }

    function getText(rec, fieldId) {
        try { return rec.getText({ fieldId: fieldId }); } catch (e) { return ''; }
    }

    function getSubVal(subrec, fieldId) {
        try { return subrec.getValue({ fieldId: fieldId }); } catch (e) { return ''; }
    }

    function getSublistVal(rec, sublistId, fieldId, line) {
        try {
            return rec.getSublistValue({
                sublistId: sublistId,
                fieldId: fieldId,
                line: line
            });
        } catch (e) {
            return '';
        }
    }

    function getSublistText(rec, sublistId, fieldId, line) {
        try {
            return rec.getSublistText({
                sublistId: sublistId,
                fieldId: fieldId,
                line: line
            });
        } catch (e) {
            return '';
        }
    }

    return { get };
});
