                safe(getVal(customerRec, 'custentity_pan')),
                safe(getVal(customerRec, 'custentity_permanent_account_number'))
            ),
            gstin: firstNonBlank(
                safe(getVal(customerRec, 'custentity_in_gstin')),
                safe(getVal(customerRec, 'custentity_gstin')),
                safe(getVal(customerRec, 'custentity_in_gst_customer_reg_no')),
                safe(getVal(customerRec, 'custentity_in_customer_gstin'))
            )
        };
    }

   function readSubsidiaryExtra(subsidiaryRec) {
    if (!subsidiaryRec) {
        return emptyAddressWithTax();
    }

    const addressText = firstNonBlank(
        safe(getVal(subsidiaryRec, 'mainaddress_text')),
        safe(getVal(subsidiaryRec, 'addrtext')),
        safe(getText(subsidiaryRec, 'mainaddress')),
        safe(getVal(subsidiaryRec, 'mainaddress'))
    );

    const country = firstNonBlank(
        safe(getText(subsidiaryRec, 'country')),
        safe(getVal(subsidiaryRec, 'country'))
    );

    return {
        name: safe(getVal(subsidiaryRec, 'name')),
        addressText: addressText,
        city: '',
        state: '',
        country: country,
        zip: '',
        pan: firstNonBlank(
            safe(getVal(subsidiaryRec, 'custrecord_in_pan_number')),
            safe(getVal(subsidiaryRec, 'custrecord_pan')),
            safe(getVal(subsidiaryRec, 'custrecord_permanent_account_number'))
        ),
        gstin: firstNonBlank(
            safe(getText(subsidiaryRec, 'federalidnumber')),
            safe(getVal(subsidiaryRec, 'federalidnumber')),
            safe(getText(subsidiaryRec, 'taxidnum')),
            safe(getVal(subsidiaryRec, 'taxidnum'))
        )
    };
}

    function readLocationExtra(locationRec) {
        if (!locationRec) {
            return emptyAddressWithTax();
        }

        const mainAddress = readGenericAddress(locationRec, 'mainaddress');

        return {
            name: safe(getVal(locationRec, 'name')),
            addressText: mainAddress.text,
            city: mainAddress.city,
            state: mainAddress.state,
            country: mainAddress.country,
            zip: mainAddress.zip,
            pan: '',
            gstin: safe(getVal(locationRec, 'custrecord_xxflx_location_tax_reg_number'))
        };
    }

    function readGenericAddress(rec, fieldId) {
        try {
            const subrec = rec.getSubrecord({ fieldId: fieldId });

            return {
                text: firstNonBlank(
                    safe(getSubVal(subrec, 'addrtext')),
                    buildAddressText(subrec)
                ),
                country: safe(getSubVal(subrec, 'country')),
                addressee: safe(getSubVal(subrec, 'addressee')),
                attention: safe(getSubVal(subrec, 'attention')),
                addrPhone: safe(getSubVal(subrec, 'addrphone')),
                addr1: safe(getSubVal(subrec, 'addr1')),
                addr2: safe(getSubVal(subrec, 'addr2')),
                addr3: safe(getSubVal(subrec, 'addr3')),
                city: safe(getSubVal(subrec, 'city')),
                state: safe(getSubVal(subrec, 'state')),
                zip: safe(getSubVal(subrec, 'zip'))
            };
        } catch (e) {
            return {
                text: '',
                country: '',
                addressee: '',
                attention: '',
                addrPhone: '',
                addr1: '',
                addr2: '',
                addr3: '',
                city: '',
                state: '',
                zip: ''
            };
        }
    }

    function buildAddressText(subrec) {
        return [
            safe(getSubVal(subrec, 'addressee')),
            safe(getSubVal(subrec, 'addr1')),
            safe(getSubVal(subrec, 'addr2')),
            safe(getSubVal(subrec, 'addr3')),
            safe(getSubVal(subrec, 'city')),
            safe(getSubVal(subrec, 'state')),
            safe(getSubVal(subrec, 'zip')),
            safe(getSubVal(subrec, 'country'))
        ].filter(function (x) {
            return x !== '';
        }).join('\n');
    }

    function emptyAddressWithTax() {
