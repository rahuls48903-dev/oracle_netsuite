  function getTaxTypeFromTaxDetails(inv, lineNumber) {
    const sublistId = 'taxdetails';
    let count = 0;
    let types = [];

    try {
        count = inv.getLineCount({ sublistId });
    } catch (e) {
        return '';
    }

    for (let i = 0; i < count; i++) {
        const ref = safe(getSublistVal(inv, sublistId, 'taxdetailsreference', i));

        if (ref && ref.endsWith('_' + lineNumber)) {
            const type = safe(getSublistText(inv, sublistId, 'taxtype', i));
            if (type) {
                types.push(type);
            }
        }
    }

    return types.join('+'); // Example: CGST+SGST
}
  function getGstRateFromTaxDetails(inv, lineNumber) {
    const sublistId = 'taxdetails';
    let count = 0;
    let totalRate = 0;

    try {
        count = inv.getLineCount({ sublistId });
    } catch (e) {
        return 0;
    }

    for (let i = 0; i < count; i++) {
        const ref = safe(getSublistVal(inv, sublistId, 'taxdetailsreference', i));

        if (ref && ref.endsWith('_' + lineNumber)) {
            const rate = Number(getSublistVal(inv, sublistId, 'taxrate', i)) || 0;
            totalRate += rate;
        }
    }

    return totalRate;
}
  function getUqcCodeFromUnits(unitsId) {
    if (!unitsId) return '';

    const searchObj = search.create({
        type: 'customrecord_india_uqc_list',
        filters: [
            ['custrecord_quantity', 'anyof', unitsId]
        ],
        columns: ['custrecord_uqc_code']
    });

    const result = searchObj.run().getRange({ start: 0, end: 1 });

    if (result && result.length > 0) {
        return result[0].getValue('custrecord_uqc_code') || '';
    }

    return '';
}
function getItemUqc(itemId, itemType) {
    try {
        if (!itemId) return '';

        const recordType = resolveItemRecordType(itemType);
        if (!recordType) return '';

        const itemRec = record.load({
            type: recordType,
            id: itemId,
            isDynamic: false
        });

        const uqcRecordId = itemRec.getValue({
            fieldId: 'custitem_uqc_code'
        });

        if (!uqcRecordId) return '';

        const uqcRec = record.load({
            type: 'customrecord735',
            id: uqcRecordId,
            isDynamic: false
        });

        return safe(uqcRec.getValue({
            fieldId: 'custrecord_uqc_code'
        }));

    } catch (e) {
        return '';
    }
}

function buildItemLinesXml(inv) {

    const sublistId = 'item';
