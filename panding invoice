/**
 * @NApiVersion 2.1
 * @NScriptType Restlet
 */
define(['N/search', 'N/format', 'N/scriptTypes/restlet'], (search, format, restlet) => {

    const get = (params) => {
        try {
            const apiKey = params.apiKey || '';
            const limit = Number(params.limit || 100);

            let xml = '<?xml version="1.0" encoding="UTF-8"?>\n';
            xml += '<DATA_DS>';

            const invoiceSearch = search.create({
                type: search.Type.INVOICE,
                filters: [
                    ['mainline', 'is', 'T'],
                    'AND',
         ['trandate', 'onorafter', '15-Jun-2026'],
       'AND',
        ['approvalstatus', 'anyof', '2'],
                  'AND',
                      ['custbody3', 'isempty', ''],
    'AND',
    ['custbody4', 'isempty', '']
    ],
                columns: [
                    'internalid',
                    'trandate',
                    'type',
                    'source',
                    'subsidiary'
                ]
            });

            let count = 0;

            invoiceSearch.run().each((result) => {
                if (count >= limit) {
                    return false;
                }

                const trxNumber = val(result, 'internalid');

                // ✅ Convert Date to ISO format
                const rawDate = result.getValue({ name: 'trandate' });
                const trxDate = formatDateISO(rawDate);

                const type = text(result, 'type');
                const sourceName = text(result, 'source');
                const orgName = text(result, 'subsidiary');

                xml += '<G_1>';
                xml += tag('APIKEYFORDATA', apiKey);
                xml += tag('TRX_NUMBER', trxNumber);
                xml += tag('TRX_DATE', trxDate); // ✅ formatted date
                xml += tag('TYPE', type);
                xml += tag('TRX_SOURCE_NAME', sourceName);
                xml += tag('ORG_NAME', orgName);
                xml += '</G_1>';

                count++;
                return true;
            });

            xml += '</DATA_DS>';

            return restlet.createResponse({
                contentType: 'application/xml',
                content: xml
            });

        } catch (e) {
            return restlet.createResponse({
                contentType: 'application/xml',
                content:
                    '<?xml version="1.0" encoding="UTF-8"?>' +
                    '<ERROR>' +
                    tag('CODE', e.name || 'ERROR') +
                    tag('MESSAGE', e.message || String(e)) +
                    '</ERROR>'
            });
        }
    };

    // ✅ Convert NetSuite Date → ISO format
    function formatDateISO(nsDate) {
        try {
            if (!nsDate) return '';

            const jsDate = format.parse({
                value: nsDate,
                type: format.Type.DATE
            });

            return new Date(jsDate).toISOString(); // ✅ 2025-09-06T00:00:00.000Z
        } catch (e) {
            return '';
        }
    }

    function val(result, name) {
        try {
            return result.getValue({ name }) || '';
        } catch (e) {
            return '';
        }
    }

    function text(result, name) {
        try {
            return result.getText({ name }) || '';
        } catch (e) {
            return '';
        }
    }

    function tag(name, value) {
        return '<' + name + '>' + esc(value) + '</' + name + '>';
    }

    function esc(value) {
        return String(value == null ? '' : value)
            .replace(/&/g, '&amp;')
            .replace(/</g, '&lt;')
            .replace(/>/g, '&gt;')
            .replace(/"/g, '&quot;')
            .replace(/'/g, '&apos;');
    }

    return { get };
});
